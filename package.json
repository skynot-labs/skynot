{
  "name": "skynot",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "console"
  ],
  "description": "A dev shop of AI agents: a Manager runs per-project teams that deliver software.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p console",
    "build:console": "npm run build -w @skynot/studio --",
    "dev:console": "npm run dev -w @skynot/studio --",
    "test": "vitest run",
    "dev": "SKYNOT_MOCK=1 tsx src/app/main.ts",
    "start": "tsx src/app/main.ts",
    "start:shared": "SKYNOT_SHARE=tailscale tsx src/app/main.ts",
    "dev:shared": "SKYNOT_MOCK=1 SKYNOT_SHARE=tailscale tsx src/app/main.ts",
    "check": "tsx src/app/check.ts",
    "design:export": "npm run design:export -w @skynot/studio --",
    "github:export": "npm run github:export -w @skynot/studio --",
    "build:github": "npm run build:github -w @skynot/studio --",
    "build:studio": "npm run build:studio -w @skynot/studio --",
    "test:e2e": "npm run test:e2e -w @skynot/studio --"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@skynot/contract": "*",
    "hono": "^4.13.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
